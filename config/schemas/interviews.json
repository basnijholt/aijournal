{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InterviewQuestions",
  "type": "object",
  "required": ["questions", "meta"],
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "target_facet": {"type": "string"},
          "priority": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "meta": {
      "type": "object",
      "required": ["llm_model", "prompt_path", "created_at"],
      "properties": {
        "llm_model": {"type": "string"},
        "prompt_path": {"type": "string"},
        "prompt_hash": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
