{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JournalEntry",
  "type": "object",
  "required": ["id", "created_at", "title", "tags"],
  "properties": {
    "id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "title": {"type": "string"},
    "tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "mood": {"type": "string"},
    "projects": {
      "type": "array",
      "items": {"type": "string"}
    },
    "summary": {"type": "string"}
  },
  "additionalProperties": true
}
