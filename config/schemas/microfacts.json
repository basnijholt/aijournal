{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MicroFacts",
  "type": "object",
  "required": ["facts", "meta"],
  "properties": {
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "confidence", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "first_seen": {"type": "string"},
          "last_seen": {"type": "string"},
          "evidence": {
            "type": "object",
            "required": ["entry_id"],
            "properties": {
              "entry_id": {"type": "string"},
              "spans": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "type": {"type": "string"},
                    "index": {"type": ["integer", "null"], "minimum": 0},
                    "start": {"type": ["integer", "null"], "minimum": 0},
                    "end": {"type": ["integer", "null"], "minimum": 0},
                    "text": {"type": ["string", "null"]}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "meta": {
      "type": "object",
      "required": ["llm_model", "prompt_path", "created_at"],
      "properties": {
        "llm_model": {"type": "string"},
        "prompt_path": {"type": "string"},
        "prompt_hash": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
