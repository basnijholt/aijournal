{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileSuggestions",
  "type": "object",
  "required": ["upserts", "updates", "meta"],
  "properties": {
    "upserts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "operation", "value"],
        "properties": {
          "target": {"type": "string"},
          "operation": {"type": "string"},
          "value": {"type": "object"},
          "rationale": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "operation", "value"],
        "properties": {
          "target": {"type": "string"},
          "operation": {"type": "string"},
          "value": {},
          "method": {"type": "string"},
          "user_verified": {"type": ["boolean", "null"]},
          "evidence": {
            "type": ["array", "null"],
            "items": {"type": "string"}
          },
          "rationale": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "meta": {
      "type": "object",
      "required": ["llm_model", "prompt_path", "created_at"],
      "properties": {
        "llm_model": {"type": "string"},
        "prompt_path": {"type": "string"},
        "prompt_hash": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
