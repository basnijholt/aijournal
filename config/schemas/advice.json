{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdviceCard",
  "type": "object",
  "required": [
    "id",
    "query",
    "assumptions",
    "recommendations",
    "alignment",
    "style",
    "meta"
  ],
  "properties": {
    "id": {"type": "string"},
    "query": {"type": "string"},
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "why_this_fits_you",
          "steps",
          "risks",
          "mitigations"
        ],
        "properties": {
          "title": {"type": "string"},
          "why_this_fits_you": {
            "type": "object",
            "properties": {
              "facets": {
                "type": "array",
                "items": {"type": "string"}
              },
              "claims": {
                "type": "array",
                "items": {"type": "string"}
              }
            },
            "additionalProperties": false
          },
          "steps": {
            "type": "array",
            "items": {"type": "string"}
          },
          "risks": {
            "type": "array",
            "items": {"type": "string"}
          },
          "mitigations": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "next_actions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "alignment": {
      "type": "object",
      "properties": {
        "facets": {
          "type": "array",
          "items": {"type": "string"}
        },
        "claims": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "tone": {"type": "string"},
        "depth": {"type": "string"}
      },
      "additionalProperties": true
    },
    "meta": {
      "type": "object",
      "required": ["llm_model", "prompt_path", "created_at"],
      "properties": {
        "llm_model": {"type": "string"},
        "prompt_path": {"type": "string"},
        "prompt_hash": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
