{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedEntry",
  "type": "object",
  "required": [
    "id",
    "created_at",
    "source_path",
    "title",
    "tags",
    "sections"
  ],
  "properties": {
    "id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_path": {"type": "string"},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heading"],
        "properties": {
          "heading": {"type": "string"},
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "summary": {"type": ["string", "null"]},
          "para_index": {
            "type": ["integer", "null"],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": {"type": "string"},
          "value": {"type": "string"},
          "extra": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "source_hash": {"type": "string"},
    "source_type": {"type": "string"}
  },
  "additionalProperties": false
}
