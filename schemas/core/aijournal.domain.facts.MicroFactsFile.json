{
  "$defs": {
    "ClaimProposal": {
      "description": "Structured claim update prepared for downstream review.",
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "manifest_hashes": {
          "items": {
            "type": "string"
          },
          "title": "Manifest Hashes",
          "type": "array"
        },
        "normalized_ids": {
          "items": {
            "type": "string"
          },
          "title": "Normalized Ids",
          "type": "array"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "review_after_days": {
          "title": "Review After Days",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus"
        },
        "strength": {
          "title": "Strength",
          "type": "number"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ClaimType"
        }
      },
      "required": [
        "type",
        "subject",
        "predicate",
        "statement",
        "scope",
        "strength",
        "status",
        "review_after_days"
      ],
      "title": "ClaimProposal",
      "type": "object"
    },
    "ClaimStatus": {
      "enum": [
        "accepted",
        "tentative",
        "rejected"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "ClaimType": {
      "enum": [
        "preference",
        "value",
        "goal",
        "boundary",
        "trait",
        "habit",
        "aversion",
        "skill"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "MicroFact": {
      "properties": {
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "$ref": "#/$defs/SourceRef"
        },
        "first_seen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Seen"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "last_seen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Seen"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement",
        "confidence",
        "evidence"
      ],
      "title": "MicroFact",
      "type": "object"
    },
    "Scope": {
      "description": "Contextual qualifiers for a claim atom.",
      "properties": {
        "context": {
          "items": {
            "type": "string"
          },
          "title": "Context",
          "type": "array"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        }
      },
      "title": "Scope",
      "type": "object"
    },
    "SourceRef": {
      "description": "Reference to a normalized entry that supports a claim or fact.",
      "properties": {
        "entry_id": {
          "title": "Entry Id",
          "type": "string"
        }
      },
      "required": [
        "entry_id"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "properties": {
    "claim_proposals": {
      "items": {
        "$ref": "#/$defs/ClaimProposal"
      },
      "title": "Claim Proposals",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/MicroFact"
      },
      "title": "Facts",
      "type": "array"
    }
  },
  "title": "MicroFactsFile",
  "type": "object"
}
