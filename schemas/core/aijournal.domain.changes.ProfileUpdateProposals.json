{
  "$defs": {
    "ClaimMethod": {
      "enum": [
        "self_report",
        "inferred",
        "behavioral"
      ],
      "title": "ClaimMethod",
      "type": "string"
    },
    "ClaimProposal": {
      "additionalProperties": false,
      "description": "Flattened claim proposal emitted by the LLM.",
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_entry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Entry"
        },
        "evidence_para": {
          "default": 0,
          "minimum": 0,
          "title": "Evidence Para",
          "type": "integer"
        },
        "manifest_hashes": {
          "items": {
            "type": "string"
          },
          "title": "Manifest Hashes",
          "type": "array"
        },
        "method": {
          "$ref": "#/$defs/ClaimMethod",
          "default": "inferred"
        },
        "normalized_ids": {
          "items": {
            "type": "string"
          },
          "title": "Normalized Ids",
          "type": "array"
        },
        "predicate": {
          "default": "states",
          "maxLength": 80,
          "title": "Predicate",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "review_after_days": {
          "default": 120,
          "title": "Review After Days",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "statement": {
          "maxLength": 160,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus",
          "default": "tentative"
        },
        "strength": {
          "default": 0.55,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Strength",
          "type": "number"
        },
        "subject": {
          "default": "self",
          "maxLength": 80,
          "title": "Subject",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ClaimType"
        },
        "user_verified": {
          "default": false,
          "title": "User Verified",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "type",
        "statement"
      ],
      "title": "ClaimProposal",
      "type": "object"
    },
    "ClaimStatus": {
      "enum": [
        "accepted",
        "tentative",
        "rejected"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "ClaimType": {
      "enum": [
        "preference",
        "value",
        "goal",
        "boundary",
        "trait",
        "habit",
        "aversion",
        "skill"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "FacetChange": {
      "additionalProperties": false,
      "description": "Facet modification proposed by characterization pipelines.",
      "properties": {
        "action": {
          "$ref": "#/$defs/FacetOperation",
          "default": "set"
        },
        "confidence": {
          "default": 0.55,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_entry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Entry"
        },
        "evidence_para": {
          "default": 0,
          "minimum": 0,
          "title": "Evidence Para",
          "type": "integer"
        },
        "method": {
          "default": "inferred",
          "title": "Method",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "review_after_days": {
          "default": 120,
          "title": "Review After Days",
          "type": "integer"
        },
        "user_verified": {
          "default": false,
          "title": "User Verified",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "path"
      ],
      "title": "FacetChange",
      "type": "object"
    },
    "FacetOperation": {
      "enum": [
        "set",
        "remove"
      ],
      "title": "FacetOperation",
      "type": "string"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "Contextual qualifiers for a claim atom.",
      "properties": {
        "conditions": {
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "context": {
          "items": {
            "type": "string"
          },
          "title": "Context",
          "type": "array"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        }
      },
      "title": "Scope",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Reference to a normalized entry and the supporting spans.",
      "properties": {
        "entry_id": {
          "title": "Entry Id",
          "type": "string"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Spans",
          "type": "array"
        }
      },
      "required": [
        "entry_id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "description": "Detailed pointer back into a source document.",
      "properties": {
        "end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index"
        },
        "start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Span",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Aggregate container for proposed claim and facet updates.",
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/ClaimProposal"
      },
      "title": "Claims",
      "type": "array"
    },
    "facets": {
      "items": {
        "$ref": "#/$defs/FacetChange"
      },
      "title": "Facets",
      "type": "array"
    },
    "interview_prompts": {
      "items": {
        "type": "string"
      },
      "title": "Interview Prompts",
      "type": "array"
    }
  },
  "title": "ProfileUpdateProposals",
  "type": "object"
}
