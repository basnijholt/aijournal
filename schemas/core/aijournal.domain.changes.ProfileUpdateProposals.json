{
  "$defs": {
    "ClaimProposal": {
      "additionalProperties": false,
      "description": "Flattened claim proposal emitted by the LLM.",
      "properties": {
        "evidence_entry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Entry"
        },
        "evidence_para": {
          "default": 0,
          "minimum": 0,
          "title": "Evidence Para",
          "type": "integer"
        },
        "predicate": {
          "default": "states",
          "maxLength": 80,
          "title": "Predicate",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "statement": {
          "maxLength": 160,
          "title": "Statement",
          "type": "string"
        },
        "subject": {
          "default": "self",
          "maxLength": 80,
          "title": "Subject",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ClaimType"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "type",
        "statement"
      ],
      "title": "ClaimProposal",
      "type": "object"
    },
    "ClaimType": {
      "enum": [
        "preference",
        "value",
        "goal",
        "boundary",
        "trait",
        "habit",
        "aversion",
        "skill"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "FacetChange": {
      "additionalProperties": false,
      "description": "Facet modification proposed by characterization pipelines.",
      "properties": {
        "action": {
          "$ref": "#/$defs/FacetOperation",
          "default": "set"
        },
        "evidence_entry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Entry"
        },
        "evidence_para": {
          "default": 0,
          "minimum": 0,
          "title": "Evidence Para",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "path"
      ],
      "title": "FacetChange",
      "type": "object"
    },
    "FacetOperation": {
      "enum": [
        "set",
        "remove"
      ],
      "title": "FacetOperation",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Aggregate container for proposed claim and facet updates.",
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/ClaimProposal"
      },
      "title": "Claims",
      "type": "array"
    },
    "facets": {
      "items": {
        "$ref": "#/$defs/FacetChange"
      },
      "title": "Facets",
      "type": "array"
    },
    "interview_prompts": {
      "items": {
        "type": "string"
      },
      "title": "Interview Prompts",
      "type": "array"
    }
  },
  "title": "ProfileUpdateProposals",
  "type": "object"
}
