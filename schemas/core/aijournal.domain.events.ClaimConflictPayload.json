{
  "$defs": {
    "ClaimSignaturePayload": {
      "description": "Serialized signature describing the target slot for a claim.",
      "properties": {
        "claim_type": {
          "title": "Claim Type",
          "type": "string"
        },
        "context": {
          "items": {
            "type": "string"
          },
          "title": "Context",
          "type": "array"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "claim_type",
        "subject",
        "predicate"
      ],
      "title": "ClaimSignaturePayload",
      "type": "object"
    },
    "SourceRef": {
      "description": "Reference to a normalized entry or retrieved chunk that supports a claim or fact.",
      "properties": {
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "entry_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Id"
        },
        "manifest_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Hash"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        }
      },
      "title": "SourceRef",
      "type": "object"
    }
  },
  "description": "Structured conflict emitted during consolidation previews.",
  "properties": {
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "existing_statement": {
      "title": "Existing Statement",
      "type": "string"
    },
    "incoming_sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Incoming Sources",
      "type": "array"
    },
    "incoming_statement": {
      "title": "Incoming Statement",
      "type": "string"
    },
    "signature": {
      "$ref": "#/$defs/ClaimSignaturePayload"
    },
    "statement": {
      "title": "Statement",
      "type": "string"
    }
  },
  "required": [
    "claim_id",
    "signature",
    "statement",
    "existing_statement",
    "incoming_statement"
  ],
  "title": "ClaimConflictPayload",
  "type": "object"
}
