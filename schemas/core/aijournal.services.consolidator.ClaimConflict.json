{
  "$defs": {
    "ClaimSignature": {
      "properties": {
        "claim_type": {
          "title": "Claim Type",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "scope": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Scope",
          "type": "array"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "claim_type",
        "subject",
        "predicate",
        "scope"
      ],
      "title": "ClaimSignature",
      "type": "object"
    },
    "SourceRef": {
      "description": "Reference to a normalized entry or retrieved chunk that supports a claim or fact.",
      "properties": {
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "entry_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Id"
        },
        "manifest_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Hash"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        }
      },
      "title": "SourceRef",
      "type": "object"
    }
  },
  "properties": {
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "existing_statement": {
      "title": "Existing Statement",
      "type": "string"
    },
    "incoming_sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Incoming Sources",
      "type": "array"
    },
    "incoming_statement": {
      "title": "Incoming Statement",
      "type": "string"
    },
    "signature": {
      "$ref": "#/$defs/ClaimSignature"
    },
    "statement": {
      "title": "Statement",
      "type": "string"
    }
  },
  "required": [
    "claim_id",
    "signature",
    "statement",
    "existing_statement",
    "incoming_statement"
  ],
  "title": "ClaimConflict",
  "type": "object"
}
