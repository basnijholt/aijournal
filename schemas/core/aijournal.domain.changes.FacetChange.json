{
  "$defs": {
    "FacetOperation": {
      "enum": [
        "set",
        "remove"
      ],
      "title": "FacetOperation",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Reference to a normalized entry and the supporting spans.",
      "properties": {
        "entry_id": {
          "title": "Entry Id",
          "type": "string"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Spans",
          "type": "array"
        }
      },
      "required": [
        "entry_id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "description": "Detailed pointer back into a source document.",
      "properties": {
        "end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index"
        },
        "start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Span",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Facet modification proposed by characterization pipelines.",
  "properties": {
    "action": {
      "$ref": "#/$defs/FacetOperation",
      "default": "set"
    },
    "confidence": {
      "default": 0.55,
      "title": "Confidence",
      "type": "number"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "evidence_entry": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Entry"
    },
    "evidence_para": {
      "default": 0,
      "minimum": 0,
      "title": "Evidence Para",
      "type": "integer"
    },
    "method": {
      "default": "inferred",
      "title": "Method",
      "type": "string"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "review_after_days": {
      "default": 120,
      "title": "Review After Days",
      "type": "integer"
    },
    "user_verified": {
      "default": false,
      "title": "User Verified",
      "type": "boolean"
    },
    "value": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    }
  },
  "required": [
    "path"
  ],
  "title": "FacetChange",
  "type": "object"
}
