{
  "$defs": {
    "ClaimAtom": {
      "description": "Typed, scoped claim describing part of the persona.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "review_after_days": {
          "default": 120,
          "title": "Review After Days",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus",
          "default": "tentative"
        },
        "strength": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Strength",
          "type": "number"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ClaimType"
        }
      },
      "required": [
        "id",
        "type",
        "subject",
        "predicate",
        "statement",
        "provenance"
      ],
      "title": "ClaimAtom",
      "type": "object"
    },
    "ClaimStatus": {
      "enum": [
        "accepted",
        "tentative",
        "rejected"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "ClaimType": {
      "enum": [
        "preference",
        "value",
        "goal",
        "boundary",
        "trait",
        "habit",
        "aversion",
        "skill"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "Provenance": {
      "description": "Provenance metadata recorded for a claim atom.",
      "properties": {
        "first_seen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Seen"
        },
        "last_updated": {
          "title": "Last Updated",
          "type": "string"
        },
        "observation_count": {
          "default": 1,
          "minimum": 1,
          "title": "Observation Count",
          "type": "integer"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "last_updated"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Scope": {
      "description": "Contextual qualifiers for a claim atom.",
      "properties": {
        "context": {
          "items": {
            "type": "string"
          },
          "title": "Context",
          "type": "array"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        }
      },
      "title": "Scope",
      "type": "object"
    },
    "SourceRef": {
      "description": "Reference to a normalized entry or retrieved chunk that supports a claim or fact.",
      "properties": {
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "entry_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Id"
        },
        "manifest_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Hash"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        }
      },
      "title": "SourceRef",
      "type": "object"
    }
  },
  "description": "Primary persona payload used by chat/advise pipelines.",
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/ClaimAtom"
      },
      "title": "Claims",
      "type": "array"
    },
    "profile": {
      "additionalProperties": true,
      "title": "Profile",
      "type": "object"
    }
  },
  "title": "PersonaCore",
  "type": "object"
}
