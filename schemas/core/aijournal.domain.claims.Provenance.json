{
  "$defs": {
    "SourceRef": {
      "description": "Reference to a normalized entry that supports a claim or fact.",
      "properties": {
        "entry_id": {
          "title": "Entry Id",
          "type": "string"
        }
      },
      "required": [
        "entry_id"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "description": "Provenance metadata recorded for a claim atom.",
  "properties": {
    "first_seen": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Seen"
    },
    "last_updated": {
      "title": "Last Updated",
      "type": "string"
    },
    "observation_count": {
      "default": 1,
      "minimum": 1,
      "title": "Observation Count",
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "last_updated"
  ],
  "title": "Provenance",
  "type": "object"
}
