{
  "$defs": {
    "ClaimType": {
      "enum": [
        "preference",
        "value",
        "goal",
        "boundary",
        "trait",
        "habit",
        "aversion",
        "skill"
      ],
      "title": "ClaimType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Lightweight claim item that LLM emits (no system metadata).",
  "properties": {
    "evidence_entry": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Entry"
    },
    "evidence_para": {
      "default": 0,
      "minimum": 0,
      "title": "Evidence Para",
      "type": "integer"
    },
    "predicate": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predicate"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "statement": {
      "maxLength": 160,
      "title": "Statement",
      "type": "string"
    },
    "subject": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject"
    },
    "type": {
      "$ref": "#/$defs/ClaimType"
    },
    "value": {
      "anyOf": [
        {
          "maxLength": 160,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    }
  },
  "required": [
    "type",
    "statement"
  ],
  "title": "PromptClaimItem",
  "type": "object"
}
