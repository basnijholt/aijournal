  "additionalProperties": false,
  "description": "Aggregated payload persisted after a calibration ingestion run.",
  "properties": {
    "ema": {
      "items": {
        "$ref": "#/$defs/EMAObservation"
      },
      "title": "Ema",
      "type": "array"
    },
    "surveys": {
      "items": {
        "$ref": "#/$defs/SurveyResponse"
      },
      "title": "Surveys",
      "type": "array"
    }
  },
  "title": "CalibrationRecord",
  "type": "object"
