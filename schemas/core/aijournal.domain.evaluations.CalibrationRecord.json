        "label": {
          "title": "Label",
          "type": "string"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "timestamp",
        "label",
        "value"
      ],
      "title": "EMAObservation",
      "type": "object"
    },
    "SurveyResponse": {
      "additionalProperties": false,
