        },
        "scales": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Scales",
          "type": "object"
        }
      },
      "required": [
        "date",
        "instrument"
      ],
      "title": "SurveyResponse",
      "type": "object"
    }
