{
  "$defs": {
    "ClaimStatus": {
      "enum": [
        "accepted",
        "tentative",
        "rejected"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "ClaimType": {
      "enum": [
        "preference",
        "value",
        "goal",
        "boundary",
        "trait",
        "habit",
        "aversion",
        "skill"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "Scope": {
      "description": "Contextual qualifiers for a claim atom.",
      "properties": {
        "context": {
          "items": {
            "type": "string"
          },
          "title": "Context",
          "type": "array"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        }
      },
      "title": "Scope",
      "type": "object"
    },
    "SourceRef": {
      "description": "Reference to a normalized entry or retrieved chunk that supports a claim or fact.",
      "properties": {
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "entry_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Id"
        },
        "manifest_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Hash"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        }
      },
      "title": "SourceRef",
      "type": "object"
    }
  },
  "description": "Structured claim update prepared for downstream review.",
  "properties": {
    "evidence": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "manifest_hashes": {
      "items": {
        "type": "string"
      },
      "title": "Manifest Hashes",
      "type": "array"
    },
    "normalized_ids": {
      "items": {
        "type": "string"
      },
      "title": "Normalized Ids",
      "type": "array"
    },
    "predicate": {
      "title": "Predicate",
      "type": "string"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "review_after_days": {
      "title": "Review After Days",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "statement": {
      "title": "Statement",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ClaimStatus"
    },
    "strength": {
      "title": "Strength",
      "type": "number"
    },
    "subject": {
      "title": "Subject",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/ClaimType"
    }
  },
  "required": [
    "type",
    "subject",
    "predicate",
    "statement",
    "scope",
    "strength",
    "status",
    "review_after_days"
  ],
  "title": "ClaimProposal",
  "type": "object"
}
